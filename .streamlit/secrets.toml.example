# CyberTrace Secrets Template
# ==============================
# Copy this file to `.streamlit/secrets.toml` for local development,
# or paste its contents into your app's "Secrets" settings on
# Streamlit Community Cloud. NEVER commit the real secrets.toml file
# to GitHub — it is already listed in .gitignore.

# ------------------------------------------------------------------
# OPTIONAL: Hosted database connection
# ------------------------------------------------------------------
# If you leave this section out entirely, CyberTrace will fall back
# to a local SQLite file at data/cybertrace.db. That is fine for
# local development and demos, but local storage is NOT guaranteed to
# persist on Streamlit Community Cloud (the filesystem is ephemeral
# and can be wiped on redeploys, restarts, or sleep/wake cycles).
#
# To use a durable hosted database instead (recommended for a real
# deployment), uncomment and fill in a connection URL below. Any
# SQLAlchemy-compatible driver works, for example:
#   postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME
#   mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
#
# [database]
# url = "postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME"
